<?xml version="1.0" encoding="utf-8"?>
<!-- An agenda row: a slightly lighter card, lighter still while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#FF1E1E24" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#FF131317" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
