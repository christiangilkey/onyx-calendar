<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the widget's agenda: a day heading, or an entry (time, colour, name, ✓ for a task). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/row_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp"
        android:textAllCaps="true"
        android:textColor="#FF7F7F89"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/row_entry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/row_time"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FFB9B9C2"
            android:textSize="11.5sp" />

        <FrameLayout
            android:id="@+id/row_bar"
            android:layout_width="3dp"
            android:layout_height="30dp"
            android:background="#FF8B7CFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFF1F1F4"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/row_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF7F7F89"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/row_done"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="Mark done"
            android:src="@drawable/ic_w_check"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
