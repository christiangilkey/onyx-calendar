<?xml version="1.0" encoding="utf-8"?>
<!-- The doomscroll saver (DoomscrollService): window changes only, so it knows which app is in front;
     it reads the active window just for a browser's address bar. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/doomscroll_description"
    android:summary="@string/doomscroll_summary"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="500"
    android:isAccessibilityTool="false" />
