<?xml version="1.0" encoding="utf-8"?>
<!--
  "Onyx Calendar": resizable both ways, from a one-row strip (what is next) to a full
  screen (the week). The layout follows the size (OnyxWidget.render).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_calendar_description"
    android:initialLayout="@layout/widget_onyx"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="900dp"
    android:maxResizeHeight="1200dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_onyx"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
