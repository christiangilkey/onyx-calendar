<?xml version="1.0" encoding="utf-8"?>
<!--
  "Onyx Calendar": 4×4 when added (the month and the picked day's agenda), resizable both
  ways from a one-row strip (what is next) to a full screen. The layout follows the size
  (OnyxWidget.render). minWidth/minHeight give the 4×4 default on launchers before Android 12.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_calendar_description"
    android:initialLayout="@layout/widget_month"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="900dp"
    android:maxResizeHeight="1200dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_month"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
