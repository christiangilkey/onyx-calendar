{
    "name": "onyx-calendar",
    "version": "1.31.0",
    "description": "A sleek black desktop calendar that merges Google, Outlook and local time blocks, with Raspberry Pi call reminders and a built-in MCP server.",
    "main": "src/main/main.js",
    "author": "Onyx Calendar contributors",
    "license": "MIT",
    "scripts": {
        "start": "electron .",
        "test": "node --test",
        "icon": "electron scripts/make-icon.js",
        "preview": "node scripts/preview.js",
        "dist": "electron-builder --win nsis --publish never",
        "mobile": "node scripts/build-mobile.js"
    },
    "dependencies": {
        "electron-updater": "^6.8.9",
        "fullcalendar": "^6.1.15",
        "moment-timezone": "^0.5.48",
        "node-ical": "^0.20.1",
        "qrcode": "^1.5.4",
        "rrule": "^2.8.1"
    },
    "devDependencies": {
        "electron": "^38.0.0",
        "electron-builder": "^26.0.0"
    },
    "build": {
        "appId": "com.onyxcalendar.app",
        "productName": "Onyx Calendar",
        "files": [
            "src/**/*",
            "package.json"
        ],
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": "nsis",
            "icon": "src/assets/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Onyx Calendar",
            "artifactName": "Onyx-Calendar-Setup-${version}.${ext}"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "christiangilkey",
                "repo": "onyx-calendar",
                "releaseType": "release"
            }
        ]
    }
}
